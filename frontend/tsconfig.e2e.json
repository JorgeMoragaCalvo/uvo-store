{
  // PROD-14a: the Playwright suite, its doubles and its launcher. They run under Node (the doubles and
  // the launcher straight from .ts, with Node's type stripping), so: Node types, erasable syntax only,
  // and relative imports with their .ts extension. DOM is there for the callbacks that run in the page
  // (page.evaluate, addInitScript).
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,

    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["e2e", "playwright.config.ts"]
}
