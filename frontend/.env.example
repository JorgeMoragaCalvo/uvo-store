VITE_DEV_PROXY_TARGET=http://demo.localhost:8080
VITE_SENTRY_DSN=
# Build-time labels (the bundle keeps whatever was set when it was built, so each variant of the frontend
# is built with its own). Environment: production | staging | development; if blank it falls back to
# Vite's MODE ("development" under `npm run dev`, "production" in any build). Release: the tag being
# built, e.g. v1.2.3 (release.yml sets it).
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
