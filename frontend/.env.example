# Backend that the dev proxy sends /api to. A page opened on <slug>.localhost:5173 reaches that store (the proxy
# keeps the subdomain and uses only this target's port); a bare localhost:5173 goes to this target's store.
VITE_DEV_PROXY_TARGET=http://demo.localhost:8080
VITE_SENTRY_DSN=
# Build-time labels (the bundle keeps whatever was set when it was built, so each variant of the frontend
# is built with its own). Environment: production | staging | development; if blank it falls back to
# Vite's MODE ("development" under `npm run dev`, "production" in any build). Release: the tag being
# built, e.g. v1.2.3. IMP-03: release.yml builds one zip per environment and sets all three, the DSN from
# the GitHub Environment variable VITE_SENTRY_DSN (docs/observabilidad.md). The DSN also goes into the
# build's CSP (csp.ts), so it must be set at build time, not at deploy time.
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
