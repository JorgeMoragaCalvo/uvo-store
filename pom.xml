<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>org.uvo</groupId>
    <artifactId>uvo-store</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>uvo-store</name>
    <description>uvo-store</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>21</java.version>
        <!-- PROD-25a. Suelo de cobertura de líneas que `mvnw verify` exige (ver jacoco-maven-plugin, más
             abajo). Es un SUELO, no una meta: el valor medido, no el que nos gustaría tener.
             Medido el 2026-10-16 con 523 tests: 76,51 % (4264 de 5573 líneas). Se fija en la parte entera
             del porcentaje medido, que deja de margen unas 28 líneas que pierdan cobertura o unas 37
             líneas nuevas sin test.
             Para subirlo: cuando una ejecución completa mida un punto o más por encima, poner aquí la
             parte entera de la nueva cifra. Bajarlo para que un build pase está mal: lo que falta es el
             test, y si de verdad hay una excepción se baja dejando escrito aquí el porqué. -->
        <jacoco.line-coverage.minimum>0.76</jacoco.line-coverage.minimum>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- PROD-15b. Formato de Prometheus para /actuator/prometheus (MetricsAuthFilter lo protege).
             La versión la fija el BOM de Boot. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- Core SDK, not the Spring Boot starter: sentry-spring-boot-starter-jakarta 8.16.0
             (latest as of this writing) references org.springframework.boot.web.client.RestClientCustomizer,
             a class Spring Boot 4 moved/removed — its autoconfiguration fails to load on this
             project's Spring Boot 4.1.0. The core SDK has no Spring Boot dependency, so it isn't
             affected; see UvoStoreApplication.main() for the manual Sentry.init() and
             GlobalExceptionHandler for the manual capture of unhandled exceptions. -->
        <dependency>
            <groupId>io.sentry</groupId>
            <artifactId>sentry</artifactId>
            <version>8.16.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>spring-dotenv</artifactId>
            <version>5.1.0</version>
        </dependency>
        <!-- Bounded, self-evicting in-memory storage for the two things that keep per-caller state:
             the rate limiter's counters (A4) and the token-version cache (A5). Version managed by
             the Spring Boot BOM. A plain ConcurrentHashMap would be a DoS vector in the limiter's
             case — anyone can vary their source IP and grow it without bound. -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.1</version>
        </dependency>
        <dependency>
            <groupId>com.stripe</groupId>
            <artifactId>stripe-java</artifactId>
            <version>29.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.github.transbankdevelopers</groupId>
            <artifactId>transbank-sdk-java</artifactId>
            <version>6.2.1</version>
        </dependency>
        <dependency>
            <groupId>com.mercadopago</groupId>
            <artifactId>sdk-java</artifactId>
            <version>3.5.0</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>2.29.52</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- The three configuration secrets lost their defaults in application.properties
                         (C4), so the tests — plain @SpringBootTest against that same file, there is no
                         src/test/resources — need their own. System properties outrank
                         application.properties in Spring's Environment, so this makes `mvnw test` and
                         `mvnw verify` self-sufficient on any machine and in CI, with no env vars in the
                         workflows and no @ActiveProfiles on the test classes.
                         These are throwaway literals, deliberately different from the old committed
                         defaults so they don't trip RequiredSecret.rejectLegacyDefault. -->
                    <systemPropertyVariables>
                        <jwt.secret>test-only-jwt-secret-not-a-real-one-at-least-32-bytes</jwt.secret>
                        <app.encryption-key>dGVzdC1vbmx5LWtleS1ub3QtYS1yZWFsLW9uZS0zMmI=</app.encryption-key>
                        <app.platform-api-key>test-only-platform-key-not-a-real-one</app.platform-api-key>
                        <!-- Los tests que suben archivos escriben bytes de verdad: la transacción
                             revierte las filas, pero lo del disco sobrevive. Sin esta línea el
                             destino era `uploads/`, el MISMO directorio que usa la aplicación en
                             desarrollo, así que `mvnw verify` tenía permiso de escritura sobre las
                             imágenes reales de la tienda y dejaba residuos entre ellas (PNG de 1x1
                             de IntegrationTestSupport.pngBytes()). Apuntando a target/, `mvnw clean`
                             se lleva la basura y la suite no puede tocar datos reales. -->
                        <app.upload-dir>${project.build.directory}/test-uploads</app.upload-dir>
                        <!-- A4: IntegrationTestSupport.loginAdmin hits the real login endpoint and
                             nearly every test uses it, so the production limit of 5/min would make
                             the suite fail intermittently once more than five tests ran inside the
                             same minute from 127.0.0.1. Raised rather than disabled, so the filter
                             stays in the chain for every test; RateLimitTest sets tiny limits of
                             its own via @SpringBootTest(properties = ...). -->
                        <app.rate-limit.login>100000</app.rate-limit.login>
                        <app.rate-limit.register>100000</app.rate-limit.register>
                        <app.rate-limit.accept-invitation>100000</app.rate-limit.accept-invitation>
                        <app.rate-limit.forgot-password>100000</app.rate-limit.forgot-password>
                        <app.rate-limit.track>100000</app.rate-limit.track>
                        <app.rate-limit.webhook>100000</app.rate-limit.webhook>
                        <!-- F18: por la misma razón, y es más necesario que los de arriba — el techo por
                             cuenta se cuenta sobre el MISMO correo, y loginAdmin usa un correo por
                             tienda, así que una clase con muchos logins del mismo admin lo tocaría
                             incluso sin compartir IP. AccountThrottleTest pone el suyo pequeño. -->
                        <app.rate-limit.account-attempts>100000</app.rate-limit.account-attempts>
                        <!-- PROD-04: el mismo host que usa IntegrationTestSupport.hostHeader(store),
                             `<slug>.localhost`, para que lo que se afirma sobre un enlace coincida con el
                             Host por el que esa tienda es alcanzable en los tests. Sin puerto en las
                             plantillas: MockMvc no escucha en ninguno y añadirlo solo haría ruido en los
                             asertos. -->
                        <app.public-url.platform-domain>localhost</app.public-url.platform-domain>
                        <app.public-url.storefront>http://{host}</app.public-url.storefront>
                        <app.public-url.api>http://{host}</app.public-url.api>
                        <!-- PROD-13b: el reloj del outbox apagado. Corre cada pocos segundos, y cada contexto
                             de Spring que la suite guarda en caché tendría el suyo despachando sobre la misma
                             base: se quedaría con las filas que un test está comprobando, o con el cerrojo
                             consultivo, y la llamada directa del test no haría nada. Los tests llaman a
                             OutboxDispatcher a mano, que es lo que se quiere medir. -->
                        <app.outbox.scheduler.enabled>false</app.outbox.scheduler.enabled>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- B10: no había forma de saber qué parte del backend tocan los tests, así que la
                 cobertura se discutía de memoria. prepare-agent inyecta el agente en el argLine que
                 surefire pasa a la JVM (surefire no define ninguno propio, así que no hay choque) y
                 el informe queda en target/site/jacoco/index.html al correr `mvnw verify`.

                 PROD-25a: ya hay número, así que `check` rompe el build si la cobertura de LÍNEAS del
                 proyecto baja de `jacoco.line-coverage.minimum` (arriba). Solo líneas y global, a
                 propósito: es la unidad en la que se cita la cobertura aquí, y un umbral por rama o por
                 paquete habría que elegirlo mirando una cifra que todavía no se ha discutido.
                 Va declarada DESPUÉS de `report`: en una misma fase Maven respeta el orden de
                 declaración, y así el informe se genera aunque el umbral falle, que es cuando hace falta.

                 Dos trampas:
                 - `verify` con un subconjunto (`-Dtest=Clase`) mide una fracción ínfima y falla el
                   umbral. Para eso, `-Djacoco.skip=true`; `mvnw test -Dtest=…` no llega a esta fase.
                 - jacoco.exec se acumula entre ejecuciones: sin `clean`, un `verify` puede pasar con
                   datos de una ejecución anterior. La CI siempre usa `clean verify`. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line-coverage.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
