# IMP-09. Configuración del respaldo del clúster PostgreSQL (pgBackRest) y de las imágenes. instalar-respaldo.sh la
# copia a /etc/uvostore/respaldo.env (600 root:root) la primera vez, genera la clave de cifrado del repositorio y se
# detiene hasta que no quede ningún CAMBIAR_.
#
# El clúster es el del servidor de la plataforma: lo comparten UvoStore (staging y production) y UvoPOS (ADR 0001).
# Un respaldo físico es de TODO el clúster, y una restauración devuelve todas sus bases al mismo punto.
#
# CUSTODIA (docs/recuperacion.md): RESPALDO_CIPHER_PASS, RESPALDO_S3_KEY y RESPALDO_S3_KEY_SECRET van al gestor de
# contraseñas del equipo, junto con APP_ENCRYPTION_KEY de cada ambiente. Sin la clave de cifrado, el repositorio no se
# puede leer: perder el servidor sin esa copia es perder los respaldos.

# Nombre de la "stanza" de pgBackRest: el clúster que se respalda.
RESPALDO_STANZA=uvopos

# s3 en el servidor real. posix solo para ensayar sin un S3 compatible (el repositorio queda en el mismo disco, que
# no protege de nada).
RESPALDO_REPO_TIPO=s3

# Bucket de respaldo: en OTRA región que el de imágenes y con credenciales propias (ops/s3/politica-iam-respaldo.json).
# La política del bucket (ops/s3/politica-bucket-respaldo.json) le niega borrar a todos menos a operaciones.
RESPALDO_S3_BUCKET=CAMBIAR_bucket_de_respaldo
RESPALDO_S3_REGION=CAMBIAR_region_por_ejemplo_us-east-1
# Vacío = el de AWS para la región (s3.<región>.amazonaws.com).
RESPALDO_S3_ENDPOINT=
RESPALDO_S3_KEY=CAMBIAR_access_key_de_respaldo
RESPALDO_S3_KEY_SECRET=CAMBIAR_secret_key_de_respaldo
# Solo para ensayar contra un S3 local: host (AWS) o path, puerto y verificación del certificado.
RESPALDO_S3_URI_STYLE=host
RESPALDO_S3_PORT=443
RESPALDO_S3_VERIFY_TLS=y
# Solo para ensayar: el endpoint del CLI de AWS (respaldar-imagenes.sh, restaurar.sh). Vacío = AWS.
RESPALDO_AWS_ENDPOINT_URL=

# Cifrado del repositorio (aes-256-cbc). La genera instalar-respaldo.sh; NO se cambia después: los respaldos ya
# hechos quedarían ilegibles.
RESPALDO_CIPHER_PASS=@@GENERAR@@

# Retención: cuántos respaldos completos (semanales) se guardan, con sus diferenciales y el WAL para ir a cualquier
# punto entre ellos. 4 = un mes de recuperación a un punto en el tiempo.
RESPALDO_RETENCION_COMPLETOS=4

# Ambientes cuyas imágenes se copian al bucket de respaldo (imagenes/<ambiente>/). Se lee el bucket de cada uno de
# /etc/uvostore/<ambiente>.env.
# Separados por espacio, sin comillas (los scripts leen el archivo línea a línea, no lo ejecutan).
RESPALDO_AMBIENTES=staging production

# Métricas para Prometheus (node_exporter, colector de archivos de texto).
RESPALDO_METRICAS_DIR=/var/lib/prometheus/node-exporter
