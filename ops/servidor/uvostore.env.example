# IMP-05. Configuración del backend de UvoStore en un ambiente (staging o production) del servidor de UvoPOS.
#
# provisionar.sh lo copia a /etc/uvostore/<ambiente>.env (root:uvostore-<ambiente>, 640) la primera vez y:
#   - completa el ambiente, el puerto del backend y el dominio de la plataforma;
#   - genera cada secreto marcado GENERAR (base64 o hex de 32 bytes con openssl), uno distinto por variable y una
#     sola vez: nunca vuelve a tocar un archivo que ya existe;
#   - se detiene mientras quede algún valor CAMBIAR_..., que solo puede poner una persona.
# Lo lee systemd (EnvironmentFile): una variable por línea, sin comillas ni "export", sin espacios alrededor del =.
#
# Qué exige cada regla al arrancar: docs/configuracion-ambientes.md (matriz y rotación). Si falta algo
# obligatorio, el proceso no arranca y el log dice qué (ProductionConfigurationCheck).
#
# Los secretos de este archivo son del ambiente: staging y production NUNCA comparten ninguno. Respaldo de
# APP_ENCRYPTION_KEY: en el gestor de secretos, porque sin ella las credenciales de pasarela guardadas en la
# base no se pueden leer (IMP-09).

# ---- Ambiente ----------------------------------------------------------------------------------------------
APP_ENVIRONMENT=@@AMBIENTE@@

# ---- Red (C03/C04) -----------------------------------------------------------------------------------------
# Solo loopback: lo único que llega al backend es nginx, en el mismo servidor. Nunca el 8080 (AlfozApi).
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=@@PUERTO_BACKEND@@
# El proxy_bind de ops/nginx/uvostore.conf.template: nginx sale desde 127.0.0.2 y solo a esa IP se le cree el
# X-Forwarded-For. El POS llama directo desde 127.0.0.1, que por eso NO está aquí.
RATE_LIMIT_TRUSTED_PROXIES=127.0.0.2
# Quién puede usar /api/platform (y leer /actuator/prometheus): el backend de UvoPOS en este mismo servidor. Si
# Prometheus recolecta desde otra máquina de la red privada, agrégala con su /32.
PLATFORM_ALLOWED_NETWORKS=127.0.0.1/32

# ---- URLs públicas -----------------------------------------------------------------------------------------
# Mismo origen para las dos: la CSP del build solo admite imágenes de 'self' o https, y los correos y el retorno
# de las pasarelas salen de estas plantillas.
PUBLIC_PLATFORM_DOMAIN=@@DOMINIO_TIENDAS@@
PUBLIC_STOREFRONT_URL=https://{host}
PUBLIC_API_URL=https://{host}

# ---- Base de datos (C07) -----------------------------------------------------------------------------------
# La base y los dos roles los crea ops/postgres/roles.sql con estos mismos nombres y contraseñas: el de la
# aplicación solo tiene DML; el de migraciones es dueño del esquema y solo lo usa Flyway al arrancar.
DB_URL=jdbc:postgresql://127.0.0.1:5432/uvostore_@@AMBIENTE@@
DB_USERNAME=uvostore_@@AMBIENTE@@_app
DB_PASSWORD=@@GENERAR_HEX@@
FLYWAY_USER=uvostore_@@AMBIENTE@@_migrador
FLYWAY_PASSWORD=@@GENERAR_HEX@@
# Conexiones del pool. El PostgreSQL es el del POS: roles.sql pone CONNECTION LIMIT a este valor + 2, para que un
# pico de UvoStore no deje sin conexiones a AlfozApi.
DB_POOL_MAX=10

# ---- Secretos de la aplicación -----------------------------------------------------------------------------
JWT_SECRET=@@GENERAR_BASE64@@
# La que manda UvoPOS en X-Platform-Key. Entregarla al equipo del POS por el gestor de secretos.
PLATFORM_API_KEY=@@GENERAR_BASE64@@
# NO se puede rotar hoy (docs/configuracion-ambientes.md). Respaldarla antes de cargar la primera credencial.
APP_ENCRYPTION_KEY=@@GENERAR_BASE64@@
# Bearer de /actuator/prometheus para el recolector (docs/observabilidad.md).
METRICS_TOKEN=@@GENERAR_HEX@@

# ---- Imágenes subidas (C09) --------------------------------------------------------------------------------
# S3, un bucket por ambiente (ops/s3/). Sin endpoint ni URL base, las URL son https://<bucket>.s3.<región>.amazonaws.com
# y el bucket tiene que permitir la lectura pública de objetos (ops/s3/politica-lectura-publica.json).
APP_STORAGE_DRIVER=s3
APP_STORAGE_S3_BUCKET=CAMBIAR_bucket_del_ambiente
APP_STORAGE_S3_REGION=CAMBIAR_region_por_ejemplo_sa-east-1
# Credenciales del usuario IAM de este ambiente, con ops/s3/politica-iam-aplicacion.json y nada más.
APP_STORAGE_S3_ACCESS_KEY=CAMBIAR_access_key
APP_STORAGE_S3_SECRET_KEY=CAMBIAR_secret_key
# Solo si hay una CDN o un dominio propio delante del bucket (https obligatorio):
# APP_STORAGE_S3_PUBLIC_BASE_URL=https://imagenes.example.cl

# ---- Correo ------------------------------------------------------------------------------------------------
MAIL_HOST=CAMBIAR_servidor_smtp
MAIL_PORT=587
MAIL_USERNAME=CAMBIAR_usuario_smtp
MAIL_PASSWORD=CAMBIAR_clave_smtp
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=CAMBIAR_remitente_verificado

# ---- Sentry (C17; docs/observabilidad.md) ------------------------------------------------------------------
# Sin DSN el arranque solo advierte. Con DSN, SENTRY_ENVIRONMENT tiene que ser igual a APP_ENVIRONMENT y
# SENTRY_RELEASE el tag desplegado: desplegar-backend.sh lo actualiza en cada despliegue.
# SENTRY_DSN=https://<clave>@<org>.ingest.sentry.io/<proyecto>
SENTRY_ENVIRONMENT=@@AMBIENTE@@
SENTRY_RELEASE=sin-desplegar

# ---- Superficies y pasarelas (C08/C15) ---------------------------------------------------------------------
SWAGGER_ENABLED=false
CUSTOMER_ACCOUNTS_ENABLED=false
SHIPPING_CARRIERS_ENABLED=
# Según C01. Apagado, el arranque advierte.
POS_ENABLED=false
# true o false, obligatorio fuera de development. Con true en production: WEBPAY_ENVIRONMENT=production y las
# credenciales que emite Transbank (en staging se permite el sandbox).
WEBPAY_ENABLED=false
# IMP-07. La misma regla para las otras dos: true o false, obligatorio fuera de development. Una pasarela sin
# homologar no se enciende: en staging se enciende para homologarla, en production solo con su expediente aprobado
# (docs/homologacion-pagos.md). Stripe no entra en la primera salida.
STRIPE_ENABLED=false
MERCADOPAGO_ENABLED=false
# WEBPAY_ENVIRONMENT=production
# WEBPAY_PARENT_COMMERCE_CODE=
# WEBPAY_API_KEY=

# IMP-09. Modo recuperación: solo para levantar una base restaurada de un respaldo (ops/respaldo/restaurar.sh lo pone en
# la copia aislada). Con true no corre ningún trabajo programado, no sale nada al POS ni al correo, y el checkout, los
# webhooks y las escrituras del panel responden 503. En el ambiente vivo va ausente o false (docs/recuperacion.md).
# APP_RECOVERY_MODE=false
