{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UvoStoreRespaldoListarRepositorio",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::@@BUCKET_RESPALDO@@"
    },
    {
      "Sid": "UvoStoreRespaldoEscribirRepositorio",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::@@BUCKET_RESPALDO@@/*"
    },
    {
      "Sid": "UvoStoreRespaldoVencerRespaldosViejos",
      "Effect": "Allow",
      "Action": ["s3:DeleteObject"],
      "Resource": "arn:aws:s3:::@@BUCKET_RESPALDO@@/pgbackrest/*"
    },
    {
      "Sid": "UvoStoreRespaldoLeerImagenes",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::@@BUCKET_IMAGENES_STAGING@@",
        "arn:aws:s3:::@@BUCKET_IMAGENES_STAGING@@/*",
        "arn:aws:s3:::@@BUCKET_IMAGENES_PRODUCTION@@",
        "arn:aws:s3:::@@BUCKET_IMAGENES_PRODUCTION@@/*"
      ]
    }
  ]
}
