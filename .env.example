# Copy to .env (gitignored) and fill in. Loaded automatically at startup by
# me.paulschwarz:spring-dotenv — no need to export anything from the terminal or from IntelliJ's
# Run Configuration. Tests don't read this file: they get their own values from the surefire
# config in pom.xml.

# --- Database (required) -----------------------------------------------------------------------
# charSet=UTF8 is mandatory on Windows, see the gotcha in CLAUDE.md.
DB_URL=jdbc:postgresql://localhost:5432/uvostore?charSet=UTF8
DB_USERNAME=uvostore
DB_PASSWORD=

# --- Secrets (required, no defaults) -----------------------------------------------------------
# The app refuses to start if any of these is missing. Generate each one with:
#   openssl rand -base64 32

# Signs admin and customer JWTs. Minimum 32 bytes. A shared or leaked value means anyone can forge
# an admin token for any store.
JWT_SECRET=

# Shared secret for the operator-only store onboarding tool (/api/platform/**, X-Platform-Key
# header, used by /plataforma/nueva-tienda in the frontend).
PLATFORM_API_KEY=

# AES-256 key (base64, decodes to exactly 32 bytes) protecting payment gateway credentials and the
# Stripe/POS secrets in the settings table, at rest.
# WARNING: changing this makes every already-encrypted row unreadable — those credentials have to
# be re-entered through the admin panel. Pick it once per environment and keep it.
APP_ENCRYPTION_KEY=

# --- Optional ----------------------------------------------------------------------------------
# Everything below has a working default in application.properties; set only what you need.

# JWT_EXPIRATION_MS=86400000

# PROD-04. La dirección pública de cada tienda, que ya no es una sola para todas (sustituye a
# APP_FRONTEND_URL). {host} se sustituye por el dominio propio de la tienda si está verificado, o por
# <nick>.PUBLIC_PLATFORM_DOMAIN. Los defaults de abajo son los de desarrollo: el storefront lo sirve Vite
# en 5173 y la API el backend en 8080.
#
# EN PRODUCCIÓN las dos plantillas son el MISMO origen https sin puerto (frontend y API tras el mismo
# proxy inverso), por ejemplo:
#   PUBLIC_PLATFORM_DOMAIN=uvostore.cl
#   PUBLIC_STOREFRONT_URL=https://{host}
#   PUBLIC_API_URL=https://{host}
# PUBLIC_PLATFORM_DOMAIN=localhost
# PUBLIC_STOREFRONT_URL=http://{host}:5173
# PUBLIC_API_URL=http://{host}:8080

# PROD-07. Cuentas de comprador, diferidas: apagadas, /api/customer/** responde 404, el checkout no
# genera invitación y no se manda el correo que promete una cuenta. La compra como invitado funciona
# igual. No encender sin las pantallas del storefront (ver CLAUDE.md, PROD-07).
# CUSTOMER_ACCOUNTS_ENABLED=false

# PROD-12. Integración con UvoPOS, diferida: apagada, /api/sync/** y /api/webhooks/pos/** responden 404 y
# no se notifica ninguna orden al POS — y notificar una orden emite un documento tributario. Hace falta
# además el ajuste "pos_sync_enabled" de la tienda. No encender sin confirmar cómo trata el receptor la
# clave de idempotencia (misma razón que POS_RETRY_ENABLED).
# POS_ENABLED=false

# PROD-12. Transportistas habilitados, por nombre separado por comas. Vacío = ninguno; el checkout solo
# ofrece tarifas propias por zona. Correos de Chile no se habilita aquí (no está implementado).
# Chilexpress requiere homologar su contrato y la tabla de códigos de comuna; si se habilita, hay que
# cambiar también CHILEXPRESS_QUOTE_URL al endpoint de producción o el backend no arranca.
# SHIPPING_CARRIERS_ENABLED=
# CHILEXPRESS_QUOTE_URL=https://testservices.wschilexpress.com/rating/api/v1.0/rate/courier

# F18. Desde qué direcciones se acepta X-Forwarded-For, en IP o CIDR separados por coma. Vacío = la
# cabecera se ignora y manda la dirección del socket. HAY QUE RELLENARLO AL PONER UN PROXY INVERSO: si no,
# todos los clientes llegan con la IP del proxy, comparten un contador y el login se corta a los 5
# intentos del conjunto.
# RATE_LIMIT_TRUSTED_PROXIES=

# File storage: "local" (default, writes to APP_UPLOAD_DIR) or "s3".
# APP_STORAGE_DRIVER=local
# APP_UPLOAD_DIR=uploads
# APP_STORAGE_S3_BUCKET=
# APP_STORAGE_S3_REGION=us-east-1
# APP_STORAGE_S3_ACCESS_KEY=
# APP_STORAGE_S3_SECRET_KEY=
# APP_STORAGE_S3_ENDPOINT=
# APP_STORAGE_S3_PUBLIC_BASE_URL=

# Stripe fallback, used only when a store has no stripe_secret_key setting of its own.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_CURRENCY=clp

# Webpay Plus Mall parent commerce (Transbank). The defaults in application.properties are
# Transbank's own published integration values — override only with real production credentials.
# WEBPAY_PARENT_COMMERCE_CODE=
# WEBPAY_API_KEY=
# WEBPAY_ENVIRONMENT=integration

# SMTP relay. With MAIL_HOST blank, EmailServiceImpl logs instead of sending and nothing breaks.
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=false
# MAIL_FROM=no-reply@uvostore.cl

# Error tracking. NOT settable here: UvoStoreApplication.main() reads it with System.getenv(),
# and spring-dotenv only populates Spring's Environment, not the OS environment. Export SENTRY_DSN
# as a real environment variable (or leave it unset — Sentry.init() no-ops on a blank DSN).
